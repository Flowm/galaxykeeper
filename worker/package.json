{
  "name": "galaxykeeper-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload --preview-alias preview-$(git rev-parse --short=8 HEAD)",
    "dev": "wrangler dev --port 8787",
    "lint": "pnpm generate-types && oxlint && oxfmt --check && tsc --noEmit",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "generate-types": "wrangler types src/worker-configuration.d.ts",
    "type-check": "pnpm generate-types && tsc --noEmit"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "wrangler": "^4.157.0"
  }
}
